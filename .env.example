# Local demo only. Replace placeholders before public deployment.
POSTGRES_DB=bakeflow
POSTGRES_USER=bakeflow
POSTGRES_PASSWORD=replace-local-db-password
DATABASE_URL=postgresql://bakeflow:replace-local-db-password@localhost:55432/bakeflow?schema=public
TEST_DATABASE_URL=postgresql://bakeflow:replace-local-db-password@localhost:55432/bakeflow_test?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_PASSWORD=replace-demo-password
CORS_ORIGIN=http://localhost:8080
# Set true behind HTTPS. Use http://localhost:5173 as CORS_ORIGIN for Vite dev.
COOKIE_SECURE=false
# demo or minimal. DEMO_ANCHOR_DATE may be fixed as YYYY-MM-DD for repeatable snapshots.
SEED_MODE=demo
